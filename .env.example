# Copy this file to .env and fill in values. Never commit .env.

# Server only. Never give these a public prefix (VITE_ or NEXT_PUBLIC_).
DATABASE_URL=            # Postgres connection string
GOOGLE_CLIENT_SECRET=    # OAuth secret, used only by the backend
SESSION_SECRET=          # signs login cookies; any long random string

# Public. Bundled into the frontend, so restrict each one by domain in its dashboard.
VITE_GOOGLE_CLIENT_ID=   # OAuth client ID
VITE_MAP_TOKEN=          # only if you use Mapbox or Google Maps; not needed for Leaflet + OSM
